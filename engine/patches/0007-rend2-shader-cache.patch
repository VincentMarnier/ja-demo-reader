+static void GLSL_CompileEagerPrograms( int *numGenShaders, int *numLightShaders, int *numEtcShaders )
+{
+	for ( size_t i = 0; i < ARRAY_LEN( jkaEagerGenericShaders ); i++ )
+	{
+		const int index = jkaEagerGenericShaders[i];
+		if ( !GLSL_IsValidPermutationForGeneric( index ) )
+		{
+			continue;
+		}
+		GLSL_CompileGenericIndex( index );
+		(*numGenShaders)++;
+	}
+
+	for ( size_t i = 0; i < ARRAY_LEN( jkaEagerLightShaders ); i++ )
+	{
+		const int index = jkaEagerLightShaders[i];
+		if ( !GLSL_IsValidPermutationForLight( index & LIGHTDEF_LIGHTTYPE_MASK, index ) )
+		{
+			continue;
+		}
+		GLSL_CompileLightAllIndex( index );
+		(*numLightShaders)++;
+	}
+
+	for ( size_t i = 0; i < ARRAY_LEN( jkaEagerFogShaders ); i++ )
+	{
+		const int index = jkaEagerFogShaders[i];
+		if ( !GLSL_IsValidPermutationForFog( index ) )
+		{
+			continue;
+		}
+		GLSL_CompileFogIndex( index );
+		(*numEtcShaders)++;
+	}
+
+	for ( size_t i = 0; i < ARRAY_LEN( jkaEagerRefractionShaders ); i++ )
+	{
+		GLSL_CompileRefractionIndex( jkaEagerRefractionShaders[i] );
+		(*numEtcShaders)++;
+	}
+
+	Allocator allocator(512 * 1024);
+	ShaderProgramBuilder builder;
+	GLSL_LoadGPUProgramTextureColor(builder, allocator);
+	(*numEtcShaders)++;
