 void UniformDataWriter::Start( shaderProgram_t *sp )
 {
+	// A lazily compiled program has no uniform table until it is built. The
+	// writer reads that table while collecting the draw item, before
+	// GLSL_BindProgram() runs, so build it here.
+	GLSL_EnsureProgram( sp );
 	shaderProgram = sp;
 }
 
