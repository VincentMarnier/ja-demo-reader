+// Eager compilation runs during engine boot/load and may yield to the browser.
+// A lazy compile happens inside a draw, so it must not Asyncify-sleep.
+static qboolean jka_glslCompileCanYield = qtrue;
+static int jka_lazyCompileCount;
+
 #ifdef __EMSCRIPTEN__
 // WebGL2 requires GLSL ES 3.00 and a default precision for fragment shaders.
 // The shader bodies are already written in GLSL 1.50-style in/out syntax.
@@ -820,9 +825,12 @@ bool ShaderProgramBuilder::Build( shaderProgram_t *shaderProgram )
 	program = 0;
 
 #ifdef __EMSCRIPTEN__
-	// Yield after each program so the browser can paint and handle input while
-	// the renderer compiles its shader variants.
-	emscripten_sleep( 0 );
+	if ( jka_glslCompileCanYield )
+	{
+		// Yield after each eager program so the browser can paint and handle
+		// input while the renderer compiles its shader variants.
+		emscripten_sleep( 0 );
+	}
 #endif
 
 	return true;
@@ -1031,8 +1039,32 @@ void GLSL_FinishGPUShader(shaderProgram_t *program)
 #endif
 }
 
+static qboolean GLSL_PrepareProgram( shaderProgram_t *program )
+{
+	if ( !program )
+	{
+		return qfalse;
+	}
+
+	GLSL_EnsureProgram( program );
+	if ( !program->compiled )
+	{
+		return qfalse;
+	}
+
+	if ( glState.currentProgram != program )
+	{
+		qglUseProgram( program->program );
+		glState.currentProgram = program;
+	}
+	return qtrue;
+}
