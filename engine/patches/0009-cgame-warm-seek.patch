+void CGVM_SeekReset( int firstSnapshotNum, int serverCommandSequence, int clientNum ) {
+	if ( !cgvm || !cls.cgameStarted ) {
+		return;
+	}
+	if ( cgvm->isLegacy ) {
+		VM_Call( cgvm, CG_SEEK_RESET, firstSnapshotNum, serverCommandSequence, clientNum );
+		return;
+	}
+	VMSwap v( cgvm );
+
+	cge->SeekReset( firstSnapshotNum, serverCommandSequence, clientNum );
+}
