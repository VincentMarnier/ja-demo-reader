 	CG_CleanJetpackGhoul2();
 }
 
+/*
+=================
+CG_SeekReset
+
+M9 Phase 5: reinitialize the cgame for an in-place demo seek.  The renderer,
+BSP, collision map and registered media stay loaded; only the per-demo cgame
+state is rebuilt.  This mirrors the state-clearing half of CG_Init without
+R_LoadWorld or the registration passes.
+
+firstSnapshotNum is the first client snapshot the cgame should request.  The
+client has already restored the keyframe and replayed to the target, so this
+is normally the oldest snapshot still in the client ring buffer.
+=================
+*/
+void CG_SeekReset( int firstSnapshotNum, int serverCommandSequence, int clientNum )
+{
+	int i;
+
+	// Do not use CG_DestroyAllGhoul2 here: it also frees the registered world
+	// item models, which stay valid across a seek.  Entities and weapon/jetpack
+	// instances are per-demo; item visuals are map media.
+	for ( i = 0; i < MAX_GENTITIES; i++ ) {
+		CG_KillCEntityG2( i );
+	}
+	CG_ShutDownG2Weapons();
+	CG_CleanJetpackGhoul2();
+	trap->FX_FreeSystem();
+	trap->ROFF_Clean();
+	trap->R_ClearDecals();
+	trap->R_WorldEffectCommand( "die" );
+
+	CG_Init_CGents();
+	CG_Init_CG();
+	CG_InitJetpackGhoul2();
+	CG_PmoveClientPointerUpdate();
+	trap->RegisterSharedMemory( cg.sharedBuffer.raw );
+
+	cg.clientNum = clientNum;
+	cgs.processedSnapshotNum = firstSnapshotNum - 1;
+	cgs.serverCommandSequence = serverCommandSequence;
+	cg.infoScreenText[0] = 0;
+
+	trap->GetGameState( &cgs.gameState );
+	CG_TransitionPermanent();
+	CG_ParseServerinfo();
+	CG_SetConfigValues();
+	CG_ClearLightStyles();
+
+	// Rebuild the player list from the restored keyframe configstrings; the
+	// old list reflected the playback position before the seek.
+	cg.loading = qtrue;
+	for ( i = 0; i < MAX_CLIENTS; i++ ) {
+		CG_NewClientInfo( i, qfalse );
+	}
+	cg.loading = qfalse;
+
+	CG_InitLocalEntities();
+	CG_InitMarkPolys();
+
+	cg.renderingThirdPerson = cg_thirdPerson.integer;
+	cg.weaponSelect = WP_BRYAR_PISTOL;
+	cg.latestSnapshotNum = 0;
+	cg.snap = NULL;
+	cg.nextSnap = NULL;
+}
+
 /*
 =================
 CG_Shutdown
