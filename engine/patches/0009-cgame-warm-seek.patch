 	cge.AutomapInput			= CG_AutomapInput;
 	cge.MiscEnt					= CG_MiscEnt;
 	cge.CameraShake				= CG_FX_CameraShake;
+	cge.SeekReset				= CG_SeekReset;
 
 	return &cge;
 }
