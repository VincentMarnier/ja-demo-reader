+// M9 diagnostics: cumulative image decode/upload counters. R_Init and
+// RE_LoadWorldMap reset them; RE_EndRegistration logs the map/game total.
+static int jkaProfileImageCount;
+static int jkaProfileImageBytes;
+static int jkaProfileDecodeMs;
+static int jkaProfileUploadMs;
+
+static int R_ProfileImageBytes( const image_t *image )
+{
+	int bytesPerPixel = 4;
+	int layers;
+
+	switch ( image->internalFormat )
+	{
+	case GL_RGBA32F:
+		bytesPerPixel = 16;
+		break;
+	case GL_RGBA16F:
+		bytesPerPixel = 8;
+		break;
+	case GL_RGB16F:
+		bytesPerPixel = 6;
+		break;
+	case GL_RGB:
+	case GL_RGB8:
+		bytesPerPixel = 3;
+		break;
+	case GL_RG:
+	case GL_RG8:
+		bytesPerPixel = 2;
+		break;
+	case GL_RED:
+	case GL_R8:
+		bytesPerPixel = 1;
+		break;
+	case GL_DEPTH_COMPONENT16:
+		bytesPerPixel = 2;
+		break;
+	case GL_DEPTH_COMPONENT24:
+		bytesPerPixel = 3;
+		break;
+	default:
+		break;
+	}
+
+	layers = ( image->flags & IMGFLAG_CUBEMAP ) ? 6 : 1;
+	if ( image->flags & IMGFLAG_2D_ARRAY )
+	{
+		layers = image->layers > 0 ? image->layers : 1;
+	}
+	return image->uploadWidth * image->uploadHeight * bytesPerPixel * layers;
+}
+
+void R_ProfileResetImageStats( void )
+{
+	jkaProfileImageCount = 0;
+	jkaProfileImageBytes = 0;
+	jkaProfileDecodeMs = 0;
+	jkaProfileUploadMs = 0;
+}
+
+void R_ProfileLogImageStats( const char *stage )
+{
+	if ( !JKA_ProfileEnabled() )
+	{
+		return;
+	}
+	JKA_ProfileLog( "images stage=%s count=%d bytes=%d mb=%.1f decodeMs=%d uploadMs=%d",
+		stage, jkaProfileImageCount, jkaProfileImageBytes,
+		jkaProfileImageBytes / ( 1024.0 * 1024.0 ), jkaProfileDecodeMs, jkaProfileUploadMs );
+}
