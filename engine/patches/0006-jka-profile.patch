+
+// M9 diagnostics: a compact per-group used/compiled/total line. A program is
+// "used" when GLSL_BindProgram() selects it at least once after compiling.
+static int jkaShaderUsed;
+static int jkaShaderCompiled;
+static int jkaShaderTotal;
+
+static void GLSL_LogProgramUsage( const char *group, shaderProgram_t *programs, int count )
+{
+	char indices[384];
+	int length = 0;
+	int used = 0;
+	int compiled = 0;
+
+	if ( !JKA_ProfileEnabled() || !programs )
+	{
+		return;
+	}
+
+	indices[0] = 0;
+	for ( int i = 0; i < count; i++ )
+	{
+		if ( programs[i].compiled )
+		{
+			compiled++;
+		}
+		if ( programs[i].used )
+		{
+			int written;
+			used++;
+			written = snprintf( indices + length, sizeof( indices ) - (size_t)length,
+				"%s%d", length ? "," : "", i );
+			if ( written > 0 )
+			{
+				length += written;
+			}
+			if ( length >= (int)sizeof( indices ) - 1 )
+			{
+				length = (int)sizeof( indices ) - 1;
+				break;
+			}
+		}
+	}
+	indices[Q_min( length, (int)sizeof( indices ) - 1 )] = 0;
+	jkaShaderUsed += used;
+	jkaShaderCompiled += compiled;
+	jkaShaderTotal += count;
+	JKA_ProfileLog( "shaders group=%s used=%d compiled=%d total=%d indices=%s",
+		group, used, compiled, count, indices );
 }
 
