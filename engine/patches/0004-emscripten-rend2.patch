index 02297602..13f62b4c 100644
--- a/codemp/cgame/cg_view.c
+++ b/codemp/cgame/cg_view.c
@@ -26,9 +26,108 @@ along with this program; if not, see <http://www.gnu.org/licenses/>.
 #include "cg_local.h"
 #include "game/bg_saga.h"
 
+#include <stdio.h>
+
 #define MASK_CAMERACLIP (MASK_SOLID|CONTENTS_PLAYERCLIP)
 #define CAMERA_SIZE	4
 
+// Third-person distance used when following a player whose recorded view
+// angles are not present in the demo (everyone except the POV client).
+#define CG_EXTERNAL_FOLLOW_RANGE	100.0f
+
+// External demo-player camera controls. These are driven by the browser
+// bridge, not by the game input system.
+static qboolean cg_freeCamActive = qfalse;
+static vec3_t cg_freeCamOrigin;
+static vec3_t cg_freeCamAngles;
+static int cg_followClient = -1;
+static int cg_externalKills[MAX_CLIENTS];
+static int cg_externalDeaths[MAX_CLIENTS];
+
+void CG_ExternalResetStats( void )
+{
+	Com_Memset( cg_externalKills, 0, sizeof( cg_externalKills ) );
+	Com_Memset( cg_externalDeaths, 0, sizeof( cg_externalDeaths ) );
+}
+
+void CG_ExternalTrackDeath( int target, int attacker )
+{
+	if ( target >= 0 && target < MAX_CLIENTS && cgs.clientinfo[target].team != TEAM_SPECTATOR ) {
+		cg_externalDeaths[target]++;
+	}
+	if ( attacker >= 0 && attacker < MAX_CLIENTS && attacker != target &&
+		cgs.clientinfo[attacker].team != TEAM_SPECTATOR ) {
+		cg_externalKills[attacker]++;
+	}
+}
+
+static void CG_ApplyExternalCamera( void )
+{
+	if ( cg_freeCamActive ) {
+		VectorCopy( cg_freeCamOrigin, cg.refdef.vieworg );
+		VectorCopy( cg_freeCamAngles, cg.refdef.viewangles );
+		cg.refdef.viewangles[ROLL] = 0.0f;
+		cg.renderingThirdPerson = qtrue;
+		return;
+	}
+
+	if ( cg_followClient >= 0 && cg_followClient < MAX_CLIENTS ) {
+		clientInfo_t *ci = &cgs.clientinfo[cg_followClient];
+		centity_t *cent = &cg_entities[cg_followClient];
+
+		if ( !ci->infoValid || ci->team == TEAM_SPECTATOR || !cent->currentValid ||
+			cent->currentState.eType != ET_PLAYER ) {
+			cg_followClient = -1;
+			return;
+		}
+
+		{
+			if ( cg_followClient == cg.snap->ps.clientNum ) {
+				// The recorded POV client has real view angles; put the camera at
+				// its model's eye position.
+				VectorCopy( cent->lerpOrigin, cg.refdef.vieworg );
+				cg.refdef.vieworg[2] += DEFAULT_VIEWHEIGHT;
+				VectorCopy( cg.predictedPlayerState.viewangles, cg.refdef.viewangles );
+				cg.renderingThirdPerson = qfalse;
+			} else {
+				// Remote demo entities have no recorded view angles. Keep the
+				// eye height but pull the camera behind the model, like the
+				// third-person demo POV.
+				vec3_t yawAngles = { 0.0f, cent->lerpAngles[YAW], 0.0f };
+				vec3_t fwd, right, up;
+
+				AngleVectors( yawAngles, fwd, right, up );
+				VectorMA( cent->lerpOrigin, -CG_EXTERNAL_FOLLOW_RANGE, fwd,
+					cg.refdef.vieworg );
+				cg.refdef.vieworg[2] += DEFAULT_VIEWHEIGHT;
+				// A level view behind the model is steadier than copying the
+				// entity's pitch, which can include death/lean angles.
+				cg.refdef.viewangles[PITCH] = 0.0f;
+				cg.refdef.viewangles[YAW] = cent->lerpAngles[YAW];
+				cg.renderingThirdPerson = qtrue;
+			}
+			cg.refdef.viewangles[ROLL] = 0.0f;
+		}
+	}
+}
+
+static void CG_JsonEscape( const char *src, char *dst, size_t size )
+{
+	size_t d = 0;
+	while ( *src && d + 2 < size ) {
+		unsigned char c = (unsigned char)*src++;
+		if ( c == '"' || c == '\\' ) {
+			dst[d++] = '\\';
+			dst[d++] = (char)c;
+		} else if ( c < 32 ) {
+			d += (size_t)snprintf( dst + d, size - d, "\\u%04x", c );
+		} else {
+			dst[d++] = (char)c;
+		}
+	}
+	dst[d] = 0;
+}
