+/*
+=============================================================================
+External demo-player bridge (browser UI)
+=============================================================================
+*/
+
+const char *CG_GetScoreboardJson( void )
+{
+	static char buffer[8192];
+	int len = 0;
+	int i, j;
+	qboolean first = qtrue;
+
+	if ( !cg.snap ) {
+		return "{\"gametype\":0,\"scores1\":-9999,\"scores2\":-9999,\"levelTime\":0,\"players\":[]}";
+	}
+
+	{
+		int levelTime = cg.time - cgs.levelStartTime;
+		if ( levelTime < 0 ) {
+			levelTime = 0;
+		}
+		len = snprintf( buffer, sizeof( buffer ),
+			"{\"gametype\":%d,\"scores1\":%d,\"scores2\":%d,\"levelTime\":%d,\"players\":[",
+			cgs.gametype, cgs.scores1, cgs.scores2, levelTime );
+	}
+
+	for ( i = 0; i < MAX_CLIENTS && len < (int)sizeof( buffer ) - 512; i++ ) {
+		clientInfo_t *ci = &cgs.clientinfo[i];
+		char name[2 * MAX_QPATH];
+		int ping = 0;
+		int score;
+		int kills;
+
+		if ( !ci->infoValid || ci->team == TEAM_SPECTATOR || !ci->name[0] ) {
+			continue;
+		}
+
+		for ( j = 0; j < cg.numScores; j++ ) {
+			if ( cg.scores[j].client == i ) {
+				ping = cg.scores[j].ping;
+				break;
+			}
+		}
+
+		kills = cg_externalKills[i];
+		score = ci->score > kills ? ci->score : kills;
+
+		CG_JsonEscape( ci->name, name, sizeof( name ) );
+		len += snprintf( buffer + len, sizeof( buffer ) - len,
+			"%s{\"num\":%d,\"name\":\"%s\",\"score\":%d,\"deaths\":%d,\"ping\":%d,\"team\":%d}",
+			first ? "" : ",", i, name, score, cg_externalDeaths[i], ping, (int)ci->team );
+		first = qfalse;
+	}
+
+	{
+		int viewClient = cg_followClient;
+		clientInfo_t *vci;
+		playerState_t *vps = NULL;
+		char viewName[2 * MAX_QPATH];
+		char saberName[2 * SABER_NAME_LENGTH];
+		int health = -1;
+		int armor = -1;
+		int weapon = 0;
+		int saberStyle = -1;
+		int saber = 0;
+
+		if ( viewClient < 0 || viewClient >= MAX_CLIENTS ) {
+			viewClient = cg.snap->ps.clientNum;
+		}
+		vci = ( viewClient >= 0 && viewClient < MAX_CLIENTS ) ? &cgs.clientinfo[viewClient] : NULL;
+
+		if ( viewClient == cg.snap->ps.clientNum ) {
+			vps = &cg.predictedPlayerState;
+			health = vps->stats[STAT_HEALTH];
+			armor = vps->stats[STAT_ARMOR];
+			weapon = vps->weapon;
+			saberStyle = vps->fd.saberAnimLevel;
+		} else if ( viewClient >= 0 && viewClient < MAX_CLIENTS ) {
+			// Base JKA snapshots do not carry remote health/armor or saber
+			// style. Duel health arrives separately in the duel configstring.
+			centity_t *cent = &cg_entities[viewClient];
+			weapon = cent->currentState.weapon;
+			// A zero here usually means the duel health configstring has not
+			// arrived, not that the player is at zero health. Keep it unknown
+			// instead of drawing a false empty bar.
+			if ( cgs.duelist1 == viewClient && cgs.duelist1health > 0 ) {
+				health = cgs.duelist1health;
+			} else if ( cgs.duelist2 == viewClient && cgs.duelist2health > 0 ) {
+				health = cgs.duelist2health;
+			} else if ( cgs.duelist3 == viewClient && cgs.duelist3health > 0 ) {
+				health = cgs.duelist3health;
+			}
+		}
+
+		saber = ( weapon == WP_SABER ) ? 1 : 0;
+		CG_JsonEscape( vci && vci->name[0] ? vci->name : "Demo player", viewName, sizeof( viewName ) );
+		CG_JsonEscape( vci ? vci->saberName : "", saberName, sizeof( saberName ) );
+
+		len += snprintf( buffer + len, sizeof( buffer ) - len,
+			"],\"view\":{\"num\":%d,\"name\":\"%s\",\"health\":%d,\"armor\":%d,"
+			"\"weapon\":%d,\"saber\":%d,\"saberStyle\":%d,\"saberName\":\"%s\"}}",
+			viewClient, viewName, health, armor, weapon, saber, saberStyle, saberName );
+		if ( len >= (int)sizeof( buffer ) ) {
+			buffer[sizeof( buffer ) - 1] = 0;
+		}
+	}
+
+	return buffer;
+}
+
+void CG_SetFollowClient( int clientNum )
+{
+	if ( clientNum < 0 || clientNum >= MAX_CLIENTS ) {
+		cg_followClient = -1;
+		return;
+	}
+
+	if ( !cgs.clientinfo[clientNum].infoValid ||
+		cgs.clientinfo[clientNum].team == TEAM_SPECTATOR ) {
+		cg_followClient = -1;
+		return;
+	}
+
+	cg_freeCamActive = qfalse;
+	cg_followClient = clientNum;
+}
+
+const char *CG_EnableFreeCam( void )
+{
+	static char buffer[256];
+
+	if ( !cg.snap ) {
+		return "null";
+	}
+
+	if ( !cg_freeCamActive ) {
+		VectorCopy( cg.refdef.vieworg, cg_freeCamOrigin );
+		VectorCopy( cg.refdef.viewangles, cg_freeCamAngles );
+		cg_freeCamActive = qtrue;
+		cg_followClient = -1;
+	}
+
+	snprintf( buffer, sizeof( buffer ),
+		"{\"x\":%.3f,\"y\":%.3f,\"z\":%.3f,\"pitch\":%.3f,\"yaw\":%.3f,\"roll\":0}",
+		cg_freeCamOrigin[0], cg_freeCamOrigin[1], cg_freeCamOrigin[2],
+		AngleNormalize180( cg_freeCamAngles[PITCH] ),
+		AngleNormalize180( cg_freeCamAngles[YAW] ) );
+	return buffer;
+}
+
+void CG_SetFreeCamPose( float x, float y, float z, float pitch, float yaw, float roll )
+{
+	if ( !cg_freeCamActive ) {
+		return;
+	}
+
+	cg_freeCamOrigin[0] = x;
+	cg_freeCamOrigin[1] = y;
+	cg_freeCamOrigin[2] = z;
+	cg_freeCamAngles[PITCH] = pitch;
+	cg_freeCamAngles[YAW] = yaw;
+	cg_freeCamAngles[ROLL] = roll;
+}
+
+void CG_DisableFreeCam( void )
+{
+	cg_freeCamActive = qfalse;
+}
