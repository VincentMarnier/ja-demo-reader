diff --git a/codemp/cgame/cg_view.c b/codemp/cgame/cg_view.c
index f95a771..5a56cae 100644
--- a/codemp/cgame/cg_view.c
+++ b/codemp/cgame/cg_view.c
@@ -1267,6 +1267,23 @@ Fixed fov at intermissions, otherwise account for fov variable and zooms.
 #define	WAVE_FREQUENCY	0.4
 float zoomFov; //this has to be global client-side
 
+/*
+====================
+CG_FovDisplayAspect
+
+The canvas can be stretched to fill a window whose aspect ratio is not the
+render target's (the app does this in fullscreen).  cg_fovAspect carries the
+displayed aspect so the horizontal/vertical FOV pair stays square there.  A
+zero value keeps the old behaviour: use the render target's aspect.
+====================
+*/
+static float CG_FovDisplayAspect( void ) {
+	if ( cg_fovAspect.value > 0.0f ) {
+		return cg_fovAspect.value;
+	}
+	return (float)cg.refdef.width / (float)cg.refdef.height;
+}
+
 static int CG_CalcFov( void ) {
 	float	x;
 	float	phase;
@@ -1372,15 +1389,17 @@ static int CG_CalcFov( void ) {
 		// Based on LordHavoc's code for Darkplaces
 		// http://www.quakeworld.nu/forum/topic/53/what-does-your-qw-look-like/page/30
 		const float baseAspect = 0.75f; // 3/4
-		const float aspect = (float)cgs.glconfig.vidWidth/(float)cgs.glconfig.vidHeight;
+		const float aspect = CG_FovDisplayAspect();
 		const float desiredFov = fov_x;
 
 		fov_x = atan( tan( desiredFov*M_PI / 360.0f ) * baseAspect*aspect )*360.0f / M_PI;
 	}
 
-	x = cg.refdef.width / tan( fov_x / 360 * M_PI );
-	fov_y = atan2( cg.refdef.height, x );
-	fov_y = fov_y * 360 / M_PI;
+	// Derive the vertical FOV from the displayed aspect, not the render target:
+	// a 4:3 target stretched to 16:9 needs the anamorphic projection for the
+	// scene to keep square pixels.
+	x = tan( fov_x / 360 * M_PI ) / CG_FovDisplayAspect();
+	fov_y = atan( x ) * 360 / M_PI;
 
 	// warp if underwater
 	cg.refdef.viewContents = CG_PointContents( cg.refdef.vieworg, -1 );
@@ -1917,15 +1936,14 @@ void CG_DrawSkyBoxPortal(const char *cstr)
 		// Based on LordHavoc's code for Darkplaces
 		// http://www.quakeworld.nu/forum/topic/53/what-does-your-qw-look-like/page/30
 		const float baseAspect = 0.75f; // 3/4
-		const float aspect = (float)cgs.glconfig.vidWidth / (float)cgs.glconfig.vidHeight;
+		const float aspect = CG_FovDisplayAspect();
 		const float desiredFov = fov_x;
 
 		fov_x = atan(tan(desiredFov*M_PI / 360.0f) * baseAspect*aspect)*360.0f / M_PI;
 	}
 
-	x = cg.refdef.width / tan( fov_x / 360 * M_PI );
-	fov_y = atan2( cg.refdef.height, x );
-	fov_y = fov_y * 360 / M_PI;
+	x = tan( fov_x / 360 * M_PI ) / CG_FovDisplayAspect();
+	fov_y = atan( x ) * 360 / M_PI;
 
 	cg.refdef.fov_x = fov_x;
 	cg.refdef.fov_y = fov_y;
