@@ -178,9 +184,18 @@ void Sys_Init( void ) {
 }
 
 static void NORETURN Sys_Exit( int ex ) {
+#ifdef __EMSCRIPTEN__
+	if ( !JKA_WorkerWindowActive() ) {
+		IN_Shutdown();
+#ifndef DEDICATED
+		SDL_Quit();
+#endif
+	}
+#else
 	IN_Shutdown();
 #ifndef DEDICATED
 	SDL_Quit();
+#endif
 #endif
 
 	NET_Shutdown();
@@ -198,6 +213,15 @@ static void NORETURN Sys_Exit( int ex ) {
 #if !defined(DEDICATED)
 static void Sys_ErrorDialog( const char *error )
 {
+#ifdef __EMSCRIPTEN__
+	if ( JKA_WorkerWindowActive() ) {
+		// The worker has no DOM for SDL_ShowSimpleMessageBox; Sys_Error already
+		// printed the message through the engine log.
+		fprintf( stderr, "%s\n", error );
+		fflush( stderr );
+		return;
+	}
+#endif
 	time_t rawtime;
 	char timeStr[32] = {}; // should really only reach ~19 chars
