diff --git a/codemp/client/cl_main.cpp b/codemp/client/cl_main.cpp
index 05eef801..650822f7 100644
--- a/codemp/client/cl_main.cpp
+++ b/codemp/client/cl_main.cpp
@@ -2443,6 +2443,19 @@ extern "C" refexport_t *GetRefAPI( int version, refimport_t *rimp );
 extern "C" refexport_t *GetRefAPIStub( int version, refimport_t *rimp );
 #endif
 
+#ifdef __EMSCRIPTEN__
+// M9 Phase 3: OffscreenCanvas window layer (win_emscripten.cpp).  Declared at
+// namespace scope because C++ does not allow a linkage specification inside a
+// block, and the renderer table is assigned inside CL_InitRef.
+extern "C" qboolean JKA_WorkerWindowActive( void );
+extern "C" window_t JKA_WIN_Init( const windowDesc_t *desc, glconfig_t *glConfig );
+extern "C" void JKA_WIN_Shutdown( void );
+extern "C" void JKA_WIN_Present( window_t *window );
+extern "C" void JKA_WIN_SetGamma( glconfig_t *glConfig, byte red[256], byte green[256], byte blue[256] );
+extern "C" void *JKA_WIN_GL_GetProcAddress( const char *proc );
+extern "C" qboolean JKA_WIN_GL_ExtensionSupported( const char *extension );
+#endif
+
 void CL_InitRef( void ) {
 	static refimport_t ri;
 	refexport_t	*ret;
@@ -2559,12 +2572,36 @@ void CL_InitRef( void ) {
 	ri.CGVMLoaded = CGVMLoaded;
 	ri.CGVM_RagCallback = CGVM_RagCallback;
 
-    ri.WIN_Init = WIN_Init;
+#ifdef __EMSCRIPTEN__
+	// M9 Phase 3: prefer the OffscreenCanvas window layer when the module runs
+	// in a dedicated worker.  SDL's browser video backend needs the DOM and is
+	// kept for the main-thread fallback.
+	{
+		if ( JKA_WorkerWindowActive() ) {
+			Com_Printf( "Using Emscripten OffscreenCanvas window layer\n" );
+			ri.WIN_Init = JKA_WIN_Init;
+			ri.WIN_SetGamma = JKA_WIN_SetGamma;
+			ri.WIN_Shutdown = JKA_WIN_Shutdown;
+			ri.WIN_Present = JKA_WIN_Present;
+			ri.GL_GetProcAddress = JKA_WIN_GL_GetProcAddress;
+			ri.GL_ExtensionSupported = JKA_WIN_GL_ExtensionSupported;
+		} else {
+			ri.WIN_Init = WIN_Init;
+			ri.WIN_SetGamma = WIN_SetGamma;
+			ri.WIN_Shutdown = WIN_Shutdown;
+			ri.WIN_Present = WIN_Present;
+			ri.GL_GetProcAddress = WIN_GL_GetProcAddress;
+			ri.GL_ExtensionSupported = WIN_GL_ExtensionSupported;
+		}
+	}
+#else
+	ri.WIN_Init = WIN_Init;
 	ri.WIN_SetGamma = WIN_SetGamma;
-    ri.WIN_Shutdown = WIN_Shutdown;
-    ri.WIN_Present = WIN_Present;
+	ri.WIN_Shutdown = WIN_Shutdown;
+	ri.WIN_Present = WIN_Present;
 	ri.GL_GetProcAddress = WIN_GL_GetProcAddress;
 	ri.GL_ExtensionSupported = WIN_GL_ExtensionSupported;
+#endif
 
 	ri.CM_GetCachedMapDiskImage = CM_GetCachedMapDiskImage;
 	ri.CM_SetCachedMapDiskImage = CM_SetCachedMapDiskImage;
